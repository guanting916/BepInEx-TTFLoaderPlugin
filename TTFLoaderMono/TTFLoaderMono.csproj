<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TTFLoaderMono</AssemblyName>
    <Description>BepInEx plugin to load TTF fonts directly</Description>
    <Version>1.2.2</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <UnityReferenceDirectory Condition="'$(UnityReferenceDirectory)' == ''">libs</UnityReferenceDirectory>
    <RootNamespace>TTFLoaderMono</RootNamespace>
    <!-- 显式禁止生成 ref/ 引用程序集，避免 CI 误打包 ref dll -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- if v6 -->
    <!-- <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.*" IncludeAssets="compile" /> -->
    <!-- if v5 -->
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.*" IncludeAssets="compile" />

    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- if v5 -->
    <Reference Include="UnityEngine">
      <HintPath>$(UnityReferenceDirectory)\UnityEngine.dll</HintPath>
    </Reference>


    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityReferenceDirectory)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(UnityReferenceDirectory)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityReferenceDirectory)\UnityEngine.TextRenderingModule.dll</HintPath>

    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityReferenceDirectory)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(UnityReferenceDirectory)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityReferenceDirectory)\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>